# Bearer token for the LEAD API, provisioned separately. Never commit it.
YTLLEAD_MCP_LEAD_API_TOKEN=

# HS256 secret the platform signs X-Verified-User-Token with (a 60s JWT,
# {"sub": "<LEAD user id>", "iat", "exp"}). Never sent on the wire.
# Generate: openssl rand -hex 32. Empty = nobody is ever signed in.
YTLLEAD_MCP_IDENTITY_SIGNING_SECRET=


YTLLEAD_MCP_LOG_LEVEL=INFO
YTLLEAD_MCP_LOG_FORMAT=human
YTLLEAD_MCP_ENV=local
